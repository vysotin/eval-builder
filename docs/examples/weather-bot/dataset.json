          "tools": {
            "get_weather": {
              "behavior": "Every city is 72F and sunny; echo the city.",
              "examples": [
                {
                  "args": {
                    "city": "Paris"
                  },
                  "response": {
                    "temp": 72,
                    "condition": "sunny",
                    "city": "Paris"
                  }
                }
              ],
              "fallback_response": {
                "temp": 72,
                "condition": "sunny",
                "city": "Paris"
              }
            },
            "get_alerts": {
              "behavior": "Paris has a heat advisory; other cities have no alerts.",
              "examples": [],
              "fallback_response": {
                "alerts": [
                  "heat advisory"
                ],
                "city": "Paris"
              }
            }
          }
        },
