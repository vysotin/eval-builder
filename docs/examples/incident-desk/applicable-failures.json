{
  "schema": "evalbuilder/applicable-failures/v1",
  "failure_types": {
    "input_validation": [
      "app:always"
    ],
    "provider_error": [
      "app:always"
    ],
    "out_of_scope": [
      "app:always"
    ],
    "branch_misrouting": [
      "edge:classify->triage_agent|status_agent|decline"
    ],
    "tool_misuse": [
      "tool:get_service_status",
      "tool:search_runbooks",
      "tool:create_ticket",
      "tool:page_oncall",
      "tool:post_status_update"
    ],
    "tool_error_handling": [
      "tool:get_service_status",
      "tool:search_runbooks",
      "tool:create_ticket",
      "tool:page_oncall",
      "tool:post_status_update"
    ],
    "prompt_injection": [
      "tool:get_service_status",
      "tool:search_runbooks",
      "tool:create_ticket",
      "tool:page_oncall",
      "tool:post_status_update"
    ],
    "retrieval_grounding": [
      "tool:search_runbooks"
    ],
    "state_loss": [
      "app:multi-turn"
    ],
    "output_contract_violation": [
      "source:structured-output"
    ],
    "constraint_violation": [
      "constraint:Never call create_ticket, page_oncall or post_status_update ",
      "constraint:Always call get_service_status before proposing remediation ",
      "constraint:Severity must be one of sev1, sev2 or sev3; offer those valu",
      "constraint:If a tool errors or returns an incomplete payload, say so an"
    ]
  }
}
