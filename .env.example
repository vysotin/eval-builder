# Judge model for LLM-as-judge evaluators: claude-cli:<model>[@effort] uses the Claude
# Code CLI with your subscription (no key); anthropic:/openai: use init_chat_model + keys.
EVALBUILDER_JUDGE_MODEL=claude-cli:sonnet
# Optional defaults for the autonomous pipeline (config file values win).
# EVALBUILDER_AGENT_MODEL=claude-cli:sonnet
# EVALBUILDER_GENERATOR_MODEL=claude-cli:sonnet
# Provider keys for API-backed judge models (leave unset to use the CLI subscription).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional LangSmith backend (local-only mode works without these).
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=
