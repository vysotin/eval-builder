# Judge model for LLM-as-judge evaluators (init_chat_model provider:model string).
EVALBUILDER_JUDGE_MODEL=anthropic:claude-sonnet-5
# Provider key matching the judge model above.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional LangSmith backend (local-only mode works without these).
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=
