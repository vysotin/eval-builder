# Model specs are provider:model[@effort]. Three kinds of provider:
#   claude-cli:<model>   Claude Code CLI with your subscription (no key)      e.g. claude-cli:sonnet@high
#   anthropic:<model>    Anthropic API key (alias: claude:)                   e.g. anthropic:claude-sonnet-5
#   openai:<model>       OpenAI API key                                       e.g. openai:gpt-5@medium
#   gemini:<model>       Google Gemini API key (aliases: google:, google_genai:) e.g. gemini:gemini-2.5-pro
#   scripted:module:fn   offline scripted model (tests)
# API providers need their package too: uv sync --extra anthropic|openai|gemini|llm
EVALBUILDER_JUDGE_MODEL=claude-cli:sonnet
# Optional defaults for the autonomous pipeline (config file values win).
# EVALBUILDER_AGENT_MODEL=claude-cli:sonnet
# EVALBUILDER_GENERATOR_MODEL=claude-cli:sonnet

# Provider keys (leave unset to use the CLI subscription).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional LangSmith backend (local-only mode works without these).
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=
